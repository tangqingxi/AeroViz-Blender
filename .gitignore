# ---------------------------------------------------------------------------
# Build output: the single current project and the transient work directory.
# Regenerated by scripts/main.py and scripts/materials.py; never versioned.
# ---------------------------------------------------------------------------
/output/
/.work/

# Blender temporary and backup files
*.blend
*.blend[0-9]
*.blend@
quit.blend

# Rendered frames and video output
/preview/
*.mp4
*.mov
*.mkv
*.avi

# ---------------------------------------------------------------------------
# Third-party model assets. Keep upstream STL/SDF/CAD files outside this
# repository: their redistribution terms are not established. See
# docs/asset-provenance.md before adding any exception here.
# ---------------------------------------------------------------------------
*.stl
*.STL
*.sdf
*.sdf.jinja
*.urdf
*.step
*.STEP
*.stp
*.stpz

# ---------------------------------------------------------------------------
# Python / tooling caches
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------------------------------------------------------------------------
# Editor and OS noise
# ---------------------------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini
*.lnk
